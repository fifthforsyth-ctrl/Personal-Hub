# Copy this file to scripts/.env.local and fill in the three values.
# scripts/.env.local is gitignored — it never leaves this machine.

# The email and password you use to sign in to Personal Hub.
# The sync script signs in as you so every note lands under your account.
HUB_EMAIL=
HUB_PASSWORD=

# Only needed for distill-notes.mjs (the theme/summary pass).
# Create one at https://console.anthropic.com/settings/keys
# The sync script works fine without this.
ANTHROPIC_API_KEY=
